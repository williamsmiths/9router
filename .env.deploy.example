# yarn deploy uses git tags + GitHub Actions (needs: gh auth login or git push access)
# No GHCR_TOKEN required for tag-based deploy.

# Optional: manual local build only (./scripts/build-ghcr.sh)
GHCR_OWNER=williamsmiths
GHCR_USER=williamsmiths
GHCR_TOKEN=

# Optional: default is linux/amd64,linux/arm64
# PLATFORMS=linux/amd64
